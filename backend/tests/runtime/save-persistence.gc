;; Sin ISO: guardar y cargar un banco mediante las mismas primitivas que el juego.
(define-extern mc-save (function int int (pointer uint8) (pointer uint8) int))
(define-extern mc-load (function int int (pointer uint8) int))
(define-extern mc-run (function none))
(define-extern mc-check-result (function int))
(define save-test-data (new 'global 'array 'uint8 #x41000))
(define save-test-summary (new 'global 'array 'uint8 64))
(defun save-test-main ()
  (mc-load 0 0 (the-as (pointer uint8) save-test-data))
  (mc-run)
  (if (= 1 (mc-check-result))
      (begin
        (format 0 "[save-test] loaded ~D ~D~%" (-> save-test-data 0) (-> save-test-data 131071))
        (if (= 123 (-> save-test-data 0))
            (begin (set! (-> save-test-data 0) 77) (set! (-> save-test-data 131071) 88))
            (begin (set! (-> save-test-data 0) 123) (set! (-> save-test-data 131071) 231)))
        )
      (begin (set! (-> save-test-data 0) 123) (set! (-> save-test-data 131071) 231)))
  (mc-save 0 0 (the-as (pointer uint8) save-test-data) (the-as (pointer uint8) save-test-summary))
  (mc-run)
  (format 0 "[save-test] save result ~D~%" (mc-check-result))
  (when (= 5 (mc-check-result))
    (mc-load 0 0 (the-as (pointer uint8) save-test-data))
    (mc-run)
    (format 0 "[save-test] rollback ~D ~D result ~D~%" (-> save-test-data 0) (-> save-test-data 131071) (mc-check-result)))
  (format 0 "[save-test] done~%")
  )
(process-spawn-function process save-test-main :to *active-pool*)
