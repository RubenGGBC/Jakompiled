;; Sin ISO: matar desde otro proceso a hilos que ya se han suspendido.
(define fiber-test-handles (new 'global 'array 'uint64 160))
(defun fiber-test-victim ()
  (loop (suspend))
  )
(defun fiber-test-controller ()
  (dotimes (i 160)
    (let ((handle (process-spawn-function process fiber-test-victim :to *active-pool*)))
      (set! (-> fiber-test-handles i) (the-as uint64 handle))
      )
    )
  (suspend)
  (suspend)
  (dotimes (i 160)
    (let ((handle (the-as (pointer process) (-> fiber-test-handles i))))
      (deactivate (-> handle 0))
      )
    )
  (format 0 "[GOAL/wasm] fiber-test: killed 160 suspended processes~%")
  )
(process-spawn-function process fiber-test-controller :to *active-pool*)
