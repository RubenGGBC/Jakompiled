+#ifdef __EMSCRIPTEN__
+// Jakompiled web: GOAL calls a mips2c function like any GOAL function, with call_indirect and the
+// uniform type (i64 x 8) -> i64. Wasm has no closures, so each registered function gets one adapter
+// from a fixed pool; the adapter does what _mips2c_call_systemv does on x86: build the MIPS register
+// state (ExecutionContext) with the GOAL fake stack below it, and return v0.
+namespace {
+constexpr int kMaxMips2cFunctions = 512;
+struct WebMips2c {
+  u64 (*exec)(void*) = nullptr;
+  u32 stack_size = 0;
+};
+WebMips2c g_web_mips2c[kMaxMips2cFunctions];
+int g_web_mips2c_count = 0;
+
+// sizes and register numbers as in asm_funcs_x86_64.asm
+constexpr u32 kContextSize = 1280;
+constexpr int kRegA0 = 4, kRegV0 = 2, kRegS6 = 22, kRegS7 = 23, kRegSp = 29;
+
+u64 web_mips2c_call(int slot, const u64 (&args)[8]) {
+  const auto& f = g_web_mips2c[slot];
+  // [GOAL fake stack (stack_size)][context]: the mips2c code moves sp down into the fake stack
+  u8* mem = (u8*)alloca(f.stack_size + kContextSize + 16);
+  u8* ctx = (u8*)(((uintptr_t)mem + f.stack_size + 15) & ~(uintptr_t)15);
+  memset(ctx, 0, kContextSize);
+  auto set_gpr = [&](int reg, u64 v) { memcpy(ctx + 16 * reg, &v, 8); };
+  for (int i = 0; i < 8; i++) {
+    set_gpr(kRegA0 + i, args[i]);  // a0-a3, t0-t3
+  }
+  set_gpr(kRegS6, jakompiled::goal_process_pointer());
+  set_gpr(kRegS7, s7.offset);
+  // the context is on the C stack, which is inside GOAL memory's address range in wasm
+  set_gpr(kRegSp, (u64)(ctx - g_ee_main_mem));
+  f.exec(ctx);
+  u64 v0;
+  memcpy(&v0, ctx + 16 * kRegV0, 8);
+  return v0;
+}
+
+template <int Slot>
+u64 web_mips2c_adapter(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4, u64 a5, u64 a6, u64 a7) {
+  const u64 args[8] = {a0, a1, a2, a3, a4, a5, a6, a7};
+  return web_mips2c_call(Slot, args);
+}
+
+using WebGoalFn = u64 (*)(u64, u64, u64, u64, u64, u64, u64, u64);
+template <int... Slots>
+constexpr auto make_adapters(std::integer_sequence<int, Slots...>) {
+  return std::array<WebGoalFn, sizeof...(Slots)>{&web_mips2c_adapter<Slots>...};
+}
+const auto g_web_mips2c_adapters =
+    make_adapters(std::make_integer_sequence<int, kMaxMips2cFunctions>{});
+}  // namespace
+#endif
