+BinaryenExpressionRef ModuleGen::check_call(BinaryenExpressionRef table_index,
+                                            BinaryenExpressionRef function_object,
+                                            const std::string& where) {
+  static const char* kCheckCall = "env:check_call";
+  if (!BinaryenGetFunction(m_module, kCheckCall)) {
+    BinaryenType params[3] = {BinaryenTypeInt32(), BinaryenTypeInt64(), BinaryenTypeInt32()};
+    BinaryenAddFunctionImport(m_module, kCheckCall, kEnvModule, "check_call",
+                              BinaryenTypeCreate(params, 3), BinaryenTypeNone());
+  }
+  const int site = m_call_sites++;
+  printf("[debug-calls] %s site %d: %s\n", m_env->name().c_str(), site, where.c_str());
+  BinaryenExpressionRef args[3] = {table_index, function_object,
+                                   BinaryenConst(m_module, BinaryenLiteralInt32(site))};
+  return BinaryenCall(m_module, kCheckCall, args, 3, BinaryenTypeNone());
+}
