+#ifdef __EMSCRIPTEN__
+namespace {
+// arg3_is_pp: the x86 trampoline passes the current process (r13) as the 4th argument. In wasm
+// the function object points to one of these adapters instead, which calls the GOAL_C_FN adapter
+// with pp in its 4th argument.
+using WebGoalFn = u64 (*)(u64, u64, u64, u64, u64, u64, u64, u64);
+constexpr int kMaxPpFunctions = 16;
+WebGoalFn g_pp_targets[kMaxPpFunctions];
+int g_pp_target_count = 0;
+
+template <int Slot>
+u64 pp_adapter(u64 a0, u64 a1, u64 a2, u64, u64 a4, u64 a5, u64 a6, u64 a7) {
+  return g_pp_targets[Slot](a0, a1, a2, jakompiled::goal_process_pointer(), a4, a5, a6, a7);
+}
+
+template <int... Slots>
+constexpr auto make_pp_adapters(std::integer_sequence<int, Slots...>) {
+  return std::array<WebGoalFn, sizeof...(Slots)>{&pp_adapter<Slots>...};
+}
+const auto g_pp_adapters = make_pp_adapters(std::make_integer_sequence<int, kMaxPpFunctions>{});
+
+void* web_pp_function(void* func) {
+  ASSERT_MSG(g_pp_target_count < kMaxPpFunctions, "too many arg3_is_pp functions");
+  const int slot = g_pp_target_count++;
+  g_pp_targets[slot] = (WebGoalFn)func;
+  return (void*)g_pp_adapters[slot];
+}
+}  // namespace
+#endif
