@@ -0,0 +1,103 @@
+// Jakompiled web: loading GOAL code compiled to wasm.
+//
+// goalc's wasm backend emits normal GOAL object files: static data, one 8-byte function object
+// per function, and the wasm module embedded at the end of the top-level segment (see
+// goalc/wasm/WasmCodegen.h). klink links the data as usual; then link_wasm_object() instantiates
+// the module against this runtime's memory and table and runs its __link export, which puts
+// every function in the table and writes the index into its function object.
+
+#include <cstdint>
+#include <cstring>
+
+#include <emscripten.h>
+
+#include "common/common_types.h"
+#include "common/link_types.h"
+#include "common/log/log.h"
+#include "common/versions/versions.h"
+
+#include "game/kernel/common/klink.h"
+#include "game/kernel/common/kscheme.h"
+#include "game/kernel/jak2/kscheme.h"
+
+extern u8* g_ee_main_mem;
+extern GameVersion g_game_version;
+
+namespace {
+constexpr u32 kEmbeddedModuleMagic = 0x4b4a5741;  // goalc/wasm/WasmCodegen.h
+}
+
+// called from JS for every sym.<name> import: GOAL address of the symbol
+extern "C" EMSCRIPTEN_KEEPALIVE u32 jakompiled_intern(const char* name) {
+  switch (g_game_version) {
+    case GameVersion::Jak2:
+      return jak2::intern_from_c(name).offset;
+    default:
+      lg::die("jakompiled: wasm GOAL objects are only supported for Jak 2 so far");
+      return 0;
+  }
+}
+
+EM_JS_DEPS(jakompiled_link, "$wasmTable,$stringToUTF8OnStack,$withStackSave,$UTF8ToString");
+
+// clang-format off
+EM_JS(int, jakompiled_instantiate,
+      (const u8* bytes, u32 size, u32 s7, u32 seg_main, u32 seg_debug, u32 seg_top,
+       const char* name), {
+  const objName = UTF8ToString(name);
+  // compile from a private copy: WebAssembly.Module rejects views of shared memory
+  const code = HEAPU8.slice(bytes, bytes + size);
+  let module;
+  try {
+    module = new WebAssembly.Module(code);
+  } catch (e) {
+    err(`[jakompiled] ${objName}: invalid wasm module: ${e}`);
+    return 0;
+  }
+  const imports = {
+    env: { mem: wasmMemory, table: wasmTable, s7: BigInt(s7) },
+    seg: { main: BigInt(seg_main), debug: BigInt(seg_debug), "top-level": BigInt(seg_top) },
+    sym: {},
+  };
+  for (const imp of WebAssembly.Module.imports(module)) {
+    if (imp.module === "sym") {
+      imports.sym[imp.name] =
+          BigInt(withStackSave(() => _jakompiled_intern(stringToUTF8OnStack(imp.name))));
+    }
+  }
+  try {
+    const instance = new WebAssembly.Instance(module, imports);
+    instance.exports.__link();
+    (globalThis.jakompiledInstances ??= []).push(instance);
+  } catch (e) {
+    err(`[jakompiled] ${objName}: ${e}`);
+    return 0;
+  }
+  return 1;
+});
+// clang-format on
+
+namespace jakompiled {
+
+void link_wasm_object(const ObjectFileHeader* ofh, const char* name) {
+  const u32 entry = ofh->code_infos[TOP_LEVEL_SEGMENT].offset + 4;
+  u32 module_offset;
+  memcpy(&module_offset, g_ee_main_mem + entry + 4, 4);
+  if (!module_offset) {
+    lg::die("jakompiled: object {} has no wasm module (was it compiled for x86?)", name);
+  }
+  const u8* header = g_ee_main_mem + entry + module_offset;
+  u32 magic, size;
+  memcpy(&magic, header, 4);
+  memcpy(&size, header + 4, 4);
+  if (magic != kEmbeddedModuleMagic) {
+    lg::die("jakompiled: object {}: bad wasm module header", name);
+  }
+  lg::debug("[jakompiled] {}: instantiating {} byte wasm module", name, size);
+  if (!jakompiled_instantiate(header + 8, size, s7.offset, ofh->code_infos[0].offset,
+                              ofh->code_infos[1].offset, ofh->code_infos[2].offset, name)) {
+    lg::die("jakompiled: could not load the wasm code of {}", name);
+  }
+}
+
+}  // namespace jakompiled
