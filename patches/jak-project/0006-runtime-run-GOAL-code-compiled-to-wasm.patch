diff --git a/game/kernel/common/goal_c_fn.h b/game/kernel/common/goal_c_fn.h
new file mode 100644
index 00000000..96c292e6
--- /dev/null
+++ b/game/kernel/common/goal_c_fn.h
@@ -0,0 +1,92 @@
+#pragma once
+
+/*!
+ * @file goal_c_fn.h
+ * Wrapping C functions so GOAL code can call them.
+ *
+ * Native: the GOAL function object holds a small machine code stub that jumps to the C function
+ * with the GOAL argument registers, so any C signature works. GOAL_C_FN(f) is just (void*)f.
+ *
+ * Jakompiled web: every GOAL function has the wasm type (i64 x 8) -> i64 and is called with
+ * call_indirect, which checks the exact type. GOAL_C_FN(f) is an adapter with that type, generated
+ * from f's real signature, and the function object holds its index in the wasm table.
+ */
+
+#include <cstring>
+#include <type_traits>
+#include <utility>
+
+#include "common/common_types.h"
+
+#ifdef __EMSCRIPTEN__
+namespace goal_c_fn {
+
+// A GOAL argument is a 64-bit register: C parameters take its low bytes (ints, floats, Ptr<T>...)
+template <typename T>
+T from_goal(u64 v) {
+  static_assert(sizeof(T) <= sizeof(u64) && std::is_trivially_copyable_v<T>,
+                "C functions called from GOAL take register-sized arguments");
+  T result;
+  memcpy(&result, &v, sizeof(T));
+  return result;
+}
+
+template <typename T>
+u64 to_goal(T v) {
+  if constexpr (std::is_integral_v<T> && std::is_signed_v<T>) {
+    return (u64)(s64)v;
+  } else {
+    static_assert(sizeof(T) <= sizeof(u64) && std::is_trivially_copyable_v<T>,
+                  "C functions called from GOAL return register-sized values");
+    u64 result = 0;
+    memcpy(&result, &v, sizeof(T));
+    return result;
+  }
+}
+
+template <auto F>
+struct Adapter;
+
+template <typename R, typename... A, R (*F)(A...)>
+struct Adapter<F> {
+  static_assert(sizeof...(A) <= 8, "GOAL passes at most 8 arguments");
+  template <size_t... I>
+  static u64 invoke(const u64* args, std::index_sequence<I...>) {
+    if constexpr (std::is_void_v<R>) {
+      F(from_goal<A>(args[I])...);
+      return 0;
+    } else {
+      return to_goal<R>(F(from_goal<A>(args[I])...));
+    }
+  }
+  static u64 call(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4, u64 a5, u64 a6, u64 a7) {
+    const u64 args[8] = {a0, a1, a2, a3, a4, a5, a6, a7};
+    return invoke(args, std::index_sequence_for<A...>{});
+  }
+};
+
+// "stack arg" functions receive the 8 GOAL arguments as an array (varargs, e.g. format)
+template <auto F>
+struct StackAdapter;
+
+template <typename R, typename P, R (*F)(P*)>
+struct StackAdapter<F> {
+  static u64 call(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4, u64 a5, u64 a6, u64 a7) {
+    u64 args[8] = {a0, a1, a2, a3, a4, a5, a6, a7};
+    if constexpr (std::is_void_v<R>) {
+      F((P*)args);
+      return 0;
+    } else {
+      return to_goal<R>(F((P*)args));
+    }
+  }
+};
+
+}  // namespace goal_c_fn
+
+#define GOAL_C_FN(f) ((void*)&goal_c_fn::Adapter<f>::call)
+#define GOAL_C_STACK_FN(f) ((void*)&goal_c_fn::StackAdapter<f>::call)
+#else
+#define GOAL_C_FN(f) ((void*)(f))
+#define GOAL_C_STACK_FN(f) ((void*)(f))
+#endif
