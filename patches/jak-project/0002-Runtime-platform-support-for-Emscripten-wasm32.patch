diff --git a/common/goal_constants.h b/common/goal_constants.h
index 7c025416..d7324726 100644
--- a/common/goal_constants.h
+++ b/common/goal_constants.h
@@ -108,6 +108,13 @@ constexpr u32 GOAL_MEMUSAGE_METHOD = 8;  // method ID of GOAL mem-usage
 constexpr int EE_MAIN_MEM_LOW_PROTECT = 512 * 1024;
 constexpr int EE_MAIN_MEM_SIZE = 128 * (1 << 20);  // 128 MB, same as PS2 TOOL
 constexpr u64 EE_MAIN_MEM_MAP = 0x2123000000;      // intentionally > 32-bit to catch pointer bugs
+#ifdef __EMSCRIPTEN__
+// Jakompiled web: EE memory lives at a fixed address of the wasm linear memory, so a
+// GOAL pointer maps to a wasm address by a constant offset that compiled GOAL code can
+// fold into the immediate offset of its loads and stores. The linker must place
+// everything else above it (-sGLOBAL_BASE >= WEB_EE_MAIN_MEM_BASE + EE_MAIN_MEM_SIZE).
+constexpr u32 WEB_EE_MAIN_MEM_BASE = 0x01000000;
+#endif
 
 // when true, attempt to map the EE memory in the low 2 GB of RAM
 // this allows us to use EE pointers as real pointers.  However, this might not always work,
diff --git a/common/util/crc32.h b/common/util/crc32.h
index aae05f51..6938bf71 100644
--- a/common/util/crc32.h
+++ b/common/util/crc32.h
@@ -25,6 +25,32 @@ inline u32 crc32(const u8* data, size_t size) {
   }
   return ~result;
 }
+#elif defined __EMSCRIPTEN__
+// wasm has no CRC32 instruction: table-driven CRC32C (Castagnoli), same results as SSE4.2
+namespace crc32_detail {
+constexpr u32 kPoly = 0x82F63B78;
+struct Table {
+  u32 v[256];
+  constexpr Table() : v() {
+    for (u32 i = 0; i < 256; i++) {
+      u32 c = i;
+      for (int k = 0; k < 8; k++) {
+        c = (c & 1) ? (c >> 1) ^ kPoly : (c >> 1);
+      }
+      v[i] = c;
+    }
+  }
+};
+inline constexpr Table kTable;
+}  // namespace crc32_detail
+// Computes CRC32C
+inline u32 crc32(const u8* data, size_t size) {
+  u32 result = 0xffffffff;
+  while (size--) {
+    result = crc32_detail::kTable.v[(result ^ *data++) & 0xff] ^ (result >> 8);
+  }
+  return ~result;
+}
 #else
 #include <immintrin.h>
 // Computes CRC32C
