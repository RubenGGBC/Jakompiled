diff --git a/game/runtime.cpp b/game/runtime.cpp
index 7b274802..7661f137 100644
--- a/game/runtime.cpp
+++ b/game/runtime.cpp
@@ -84,6 +84,10 @@
 #include "game/overlord/jak3/overlord.h"
 #include "game/system/Deci2Server.h"
 #include "game/system/iop_thread.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten/heap.h>
+extern "C" char __global_base;  // start of the data segment, set by -sGLOBAL_BASE
+#endif
 #include "sce/deci2.h"
 #include "sce/iop.h"
 #include "sce/libcdvd_ee.h"
@@ -153,6 +157,17 @@ void deci2_runner(SystemThreadInterface& iface) {
  */
 void ee_runner(SystemThreadInterface& iface) {
   prof().root_event();
+#ifdef __EMSCRIPTEN__
+  // Jakompiled web: reserved region of the linear memory (see WEB_EE_MAIN_MEM_BASE)
+  {
+    const auto ee_end = (uintptr_t)WEB_EE_MAIN_MEM_BASE + EE_MAIN_MEM_SIZE;
+    if ((uintptr_t)&__global_base < ee_end || emscripten_get_heap_size() < ee_end) {
+      lg::die("EE memory overlaps the wasm data segment (global base 0x{:x}, heap size 0x{:x})",
+              (uintptr_t)&__global_base, emscripten_get_heap_size());
+    }
+    g_ee_main_mem = (u8*)(uintptr_t)WEB_EE_MAIN_MEM_BASE;
+  }
+#else
   // Allocate Main RAM. Must have execute enabled.
   // Apple Silicon uses separate writable and executable mappings for EE memory.
   if (EE_MEM_LOW_MAP) {
@@ -175,6 +190,7 @@ void ee_runner(SystemThreadInterface& iface) {
                   MAP_ANONYMOUS | MAP_PRIVATE, 0, 0);
 #endif
   }
+#endif
 
   if (g_ee_main_mem == (u8*)(-1)) {
     lg::debug("Failed to initialize main memory! {}", strerror(errno));
@@ -224,7 +240,9 @@ void ee_runner(SystemThreadInterface& iface) {
   // prevent access to the first 512 kB of memory.
   // On the PS2 this is the kernel and can't be accessed either.
   // this may not work well on systems with a page size > 1 MB.
+#ifndef __EMSCRIPTEN__  // wasm memory has no page protection
   mprotect((void*)g_ee_main_mem, EE_MAIN_MEM_LOW_PROTECT, PROT_NONE);
+#endif
   fileio_init_globals();
   jak1::kboot_init_globals();
   jak2::kboot_init_globals();
@@ -514,7 +532,9 @@ RuntimeExitStatus exec_runtime(GameLaunchOptions game_options, int argc, const c
     Gfx::Exit();
   }
   lg::info("GOAL Runtime Shutdown (code {})", fmt::underlying(MasterExit));
+#ifndef __EMSCRIPTEN__
   munmap(g_ee_main_mem, EE_MAIN_MEM_SIZE);
+#endif
   Discord_Shutdown();
   return MasterExit;
 }
