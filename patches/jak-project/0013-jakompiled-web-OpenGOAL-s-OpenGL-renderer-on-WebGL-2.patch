+++ b/web/gl_web.cpp
@@ -0,0 +1,306 @@
+// Jakompiled web: the OpenGL 4.3 calls of OpenGOAL's renderer on top of WebGL 2 (GLES 3.0).
+//
+// glad loads every GL 4.3 entry point the browser provides (third-party/glad/src/glad.c). Of the
+// functions the renderer uses, 13 don't exist in WebGL 2; this file fills them in, and wraps a few
+// that do exist but take values WebGL 2 rejects:
+//
+//   glPrimitiveRestartIndex(UINT32_MAX)  WebGL 2 always restarts at the maximum index: no-op
+//   glEnable(GL_PRIMITIVE_RESTART)...    desktop-only capabilities: ignored
+//   GL_TEXTURE_1D                        2D texture of height 1 (the shaders are translated to
+//                                        sampler2D by web/glsl_es.py, with y = 0)
+//   GL_UNSIGNED_INT_8_8_8_8_REV          with GL_RGBA it's the same bytes as GL_UNSIGNED_BYTE on a
+//                                        little-endian machine
+//   glMultiDrawElements                  one glDrawElements per draw
+//   glFramebufferTexture                 glFramebufferTexture2D
+//   glGetTexLevelParameteriv             sizes recorded when textures are created
+//   glGetTexImage                        read back through a framebuffer
+//   glColorMaski(0, ...)                 glColorMask (the renderer only uses draw buffer 0)
+//   glClearDepth, glPolygonMode, debug   glClearDepthf; no-ops
+
+#include <cstdint>
+#include <cstring>
+#include <unordered_map>
+#include <vector>
+
+#include "common/log/log.h"
+
+#include "third-party/glad/include/glad/glad.h"
+
+namespace {
+
+PFNGLBINDTEXTUREPROC orig_BindTexture;
+PFNGLACTIVETEXTUREPROC orig_ActiveTexture;
+PFNGLTEXPARAMETERIPROC orig_TexParameteri;
+PFNGLTEXPARAMETERFPROC orig_TexParameterf;
+PFNGLTEXIMAGE2DPROC orig_TexImage2D;
+PFNGLTEXSUBIMAGE2DPROC orig_TexSubImage2D;
+PFNGLTEXSTORAGE2DPROC orig_TexStorage2D;
+PFNGLREADPIXELSPROC orig_ReadPixels;
+PFNGLENABLEPROC orig_Enable;
+PFNGLDISABLEPROC orig_Disable;
+
+GLenum map_target(GLenum target) {
+  return target == GL_TEXTURE_1D ? GL_TEXTURE_2D : target;
+}
+
+GLenum map_type(GLenum type) {
+  return type == GL_UNSIGNED_INT_8_8_8_8_REV ? GL_UNSIGNED_BYTE : type;
+}
+
+bool desktop_only_cap(GLenum cap) {
+  switch (cap) {
+    case GL_PRIMITIVE_RESTART:
+    case GL_DEBUG_OUTPUT:
+    case GL_DEBUG_OUTPUT_SYNCHRONOUS:
+    case GL_TEXTURE_CUBE_MAP_SEAMLESS:
+    case GL_MULTISAMPLE:
+    case GL_PROGRAM_POINT_SIZE:
+    case GL_LINE_SMOOTH:
+    case GL_DEPTH_CLAMP:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// level 0 size of each 2D texture, and the texture bound to each unit (for glGetTexLevelParameteriv)
+struct Size {
+  int w = 0, h = 0;
+};
+std::unordered_map<GLuint, Size> g_sizes;
+GLuint g_bound_2d[32];
+int g_unit = 0;
+
+void APIENTRY web_ActiveTexture(GLenum unit) {
+  g_unit = (int)(unit - GL_TEXTURE0) & 31;
+  orig_ActiveTexture(unit);
+}
+
+void APIENTRY web_BindTexture(GLenum target, GLuint tex) {
+  target = map_target(target);
+  if (target == GL_TEXTURE_2D) {
+    g_bound_2d[g_unit] = tex;
+  }
+  orig_BindTexture(target, tex);
+}
+
+void APIENTRY web_TexParameteri(GLenum target, GLenum pname, GLint param) {
+  orig_TexParameteri(map_target(target), pname, param);
+}
+
+void APIENTRY web_TexParameterf(GLenum target, GLenum pname, GLfloat param) {
+  orig_TexParameterf(map_target(target), pname, param);
+}
+
+void APIENTRY web_TexImage2D(GLenum target,
+                             GLint level,
+                             GLint internalformat,
+                             GLsizei w,
+                             GLsizei h,
+                             GLint border,
+                             GLenum format,
+                             GLenum type,
+                             const void* data) {
+  target = map_target(target);
+  if (target == GL_TEXTURE_2D && level == 0) {
+    g_sizes[g_bound_2d[g_unit]] = {w, h};
+  }
+  orig_TexImage2D(target, level, internalformat, w, h, border, format, map_type(type), data);
+}
+
+void APIENTRY web_TexSubImage2D(GLenum target,
+                                GLint level,
+                                GLint x,
+                                GLint y,
+                                GLsizei w,
+                                GLsizei h,
+                                GLenum format,
+                                GLenum type,
+                                const void* data) {
+  orig_TexSubImage2D(map_target(target), level, x, y, w, h, format, map_type(type), data);
+}
+
+void APIENTRY web_TexStorage2D(GLenum target, GLsizei levels, GLenum fmt, GLsizei w, GLsizei h) {
+  target = map_target(target);
+  if (target == GL_TEXTURE_2D) {
+    g_sizes[g_bound_2d[g_unit]] = {w, h};
+  }
+  orig_TexStorage2D(target, levels, fmt, w, h);
+}
+
+void APIENTRY web_ReadPixels(GLint x,
+                             GLint y,
+                             GLsizei w,
+                             GLsizei h,
+                             GLenum format,
+                             GLenum type,
+                             void* data) {
+  orig_ReadPixels(x, y, w, h, format, map_type(type), data);
+}
+
+void APIENTRY web_Enable(GLenum cap) {
+  if (!desktop_only_cap(cap)) {
+    orig_Enable(cap);
+  }
+}
+
+void APIENTRY web_Disable(GLenum cap) {
+  if (!desktop_only_cap(cap)) {
+    orig_Disable(cap);
+  }
+}
+
+// ---- functions WebGL 2 doesn't have
+
+void APIENTRY web_PrimitiveRestartIndex(GLuint index) {
+  if (index != UINT32_MAX) {
+    lg::warn("jakompiled: glPrimitiveRestartIndex({}) isn't possible in WebGL 2", index);
+  }
+}
+
+void APIENTRY web_PolygonMode(GLenum, GLenum) {}  // wireframe debug view only
+
+void APIENTRY web_ClearDepth(GLdouble d) {
+  glClearDepthf((GLfloat)d);
+}
+
+void APIENTRY web_ColorMaski(GLuint buf, GLboolean r, GLboolean g, GLboolean b, GLboolean a) {
+  if (buf == 0) {
+    glColorMask(r, g, b, a);
+  }
+}
+
+void APIENTRY web_FramebufferTexture(GLenum target, GLenum attachment, GLuint tex, GLint level) {
+  glFramebufferTexture2D(target, attachment, GL_TEXTURE_2D, tex, level);
+}
+
+void APIENTRY web_MultiDrawElements(GLenum mode,
+                                    const GLsizei* count,
+                                    GLenum type,
+                                    const void* const* indices,
+                                    GLsizei drawcount) {
+  for (GLsizei i = 0; i < drawcount; i++) {
+    if (count[i] > 0) {
+      glDrawElements(mode, count[i], type, indices[i]);
+    }
+  }
+}
+
+void APIENTRY web_TexImage1D(GLenum target,
+                             GLint level,
+                             GLint internalformat,
+                             GLsizei w,
+                             GLint border,
+                             GLenum format,
+                             GLenum type,
+                             const void* data) {
+  web_TexImage2D(target, level, internalformat, w, 1, border, format, type, data);
+}
+
+void APIENTRY web_TexSubImage1D(GLenum target,
+                                GLint level,
+                                GLint x,
+                                GLsizei w,
+                                GLenum format,
+                                GLenum type,
+                                const void* data) {
+  web_TexSubImage2D(target, level, x, 0, w, 1, format, type, data);
+}
+
+void APIENTRY web_GetTexLevelParameteriv(GLenum target, GLint level, GLenum pname, GLint* out) {
+  const auto it = g_sizes.find(g_bound_2d[g_unit]);
+  if (map_target(target) != GL_TEXTURE_2D || it == g_sizes.end()) {
+    *out = 0;
+    return;
+  }
+  if (pname == GL_TEXTURE_WIDTH) {
+    *out = std::max(1, it->second.w >> level);
+  } else if (pname == GL_TEXTURE_HEIGHT) {
+    *out = std::max(1, it->second.h >> level);
+  } else {
+    *out = 0;
+  }
+}
+
+void APIENTRY web_GetTexImage(GLenum target, GLint level, GLenum format, GLenum type, void* out) {
+  GLint w = 0, h = 0;
+  web_GetTexLevelParameteriv(target, level, GL_TEXTURE_WIDTH, &w);
+  web_GetTexLevelParameteriv(target, level, GL_TEXTURE_HEIGHT, &h);
+  if (!w || !h) {
+    return;
+  }
+  // attach the texture to a temporary framebuffer and read it as RGBA bytes
+  GLint prev_fb = 0;
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prev_fb);
+  GLuint fb;
+  glGenFramebuffers(1, &fb);
+  glBindFramebuffer(GL_FRAMEBUFFER, fb);
+  glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                         g_bound_2d[g_unit], level);
+  std::vector<uint8_t> rgba((size_t)w * h * 4);
+  orig_ReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+  glBindFramebuffer(GL_FRAMEBUFFER, prev_fb);
+  glDeleteFramebuffers(1, &fb);
+
+  type = map_type(type);
+  if (format == GL_RGBA && type == GL_UNSIGNED_BYTE) {
+    memcpy(out, rgba.data(), rgba.size());
+  } else if (format == GL_RED && type == GL_UNSIGNED_BYTE) {
+    for (size_t i = 0; i < (size_t)w * h; i++) {
+      ((uint8_t*)out)[i] = rgba[i * 4];
+    }
+  } else {
+    lg::warn("jakompiled: glGetTexImage format 0x{:x} type 0x{:x} not supported", format, type);
+  }
+}
+
+void APIENTRY web_TexImage2DMultisample(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLboolean) {
+  lg::die("jakompiled: multisample textures don't exist in WebGL 2 (MSAA is disabled on web)");
+}
+
+void APIENTRY web_DebugMessageControl(GLenum, GLenum, GLenum, GLsizei, const GLuint*, GLboolean) {}
+void APIENTRY web_DebugMessageCallback(GLDEBUGPROC, const void*) {}
+
+}  // namespace
+
+namespace jakompiled {
+
+void gl_web_init() {
+  orig_BindTexture = glad_glBindTexture;
+  orig_ActiveTexture = glad_glActiveTexture;
+  orig_TexParameteri = glad_glTexParameteri;
+  orig_TexParameterf = glad_glTexParameterf;
+  orig_TexImage2D = glad_glTexImage2D;
+  orig_TexSubImage2D = glad_glTexSubImage2D;
+  orig_TexStorage2D = glad_glTexStorage2D;
+  orig_ReadPixels = glad_glReadPixels;
+  orig_Enable = glad_glEnable;
+  orig_Disable = glad_glDisable;
+
+  glad_glBindTexture = web_BindTexture;
+  glad_glActiveTexture = web_ActiveTexture;
+  glad_glTexParameteri = web_TexParameteri;
+  glad_glTexParameterf = web_TexParameterf;
+  glad_glTexImage2D = web_TexImage2D;
+  glad_glTexSubImage2D = web_TexSubImage2D;
+  glad_glTexStorage2D = web_TexStorage2D;
+  glad_glReadPixels = web_ReadPixels;
+  glad_glEnable = web_Enable;
+  glad_glDisable = web_Disable;
+
+  glad_glPrimitiveRestartIndex = web_PrimitiveRestartIndex;
+  glad_glPolygonMode = web_PolygonMode;
+  glad_glClearDepth = web_ClearDepth;
+  glad_glColorMaski = web_ColorMaski;
+  glad_glFramebufferTexture = web_FramebufferTexture;
+  glad_glMultiDrawElements = web_MultiDrawElements;
+  glad_glTexImage1D = web_TexImage1D;
+  glad_glTexSubImage1D = web_TexSubImage1D;
+  glad_glGetTexLevelParameteriv = web_GetTexLevelParameteriv;
+  glad_glGetTexImage = web_GetTexImage;
+  glad_glTexImage2DMultisample = web_TexImage2DMultisample;
+  glad_glDebugMessageControl = web_DebugMessageControl;
+  glad_glDebugMessageCallback = web_DebugMessageCallback;
+}
+
+}  // namespace jakompiled
