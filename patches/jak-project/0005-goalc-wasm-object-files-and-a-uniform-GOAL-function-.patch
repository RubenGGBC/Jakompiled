+ *  - Every GOAL function has the same wasm type, (i64 x 8) -> i64, and callers pad the arguments
+ *    they don't pass with zeros. x86 GOAL code tolerates calling a function with more or fewer
+ *    arguments than it takes (methods, casts, run-function-in-process); wasm checks the exact type
+ *    of every indirect call, so a single type keeps those calls working.
  *  - A GOAL function value is the GOAL address of a function object whose first word holds the
  *    function's index in the imported table. Calls load it and use call_indirect.
  *  - s7 (symbol table) and every symbol / function object used are imported i64 globals, so the
@@ -35,6 +38,7 @@ class FileEnv;
 class FunctionEnv;
 class RegVal;
 class StaticObject;
+class TypeSystem;
 
 namespace wasm_backend {
 
@@ -45,6 +49,27 @@ constexpr const char* kTableName = "table";
 constexpr const char* kS7Global = "s7";
 constexpr const char* kSymbolModule = "sym";     // sym.<name>: GOAL address of a symbol
 constexpr const char* kFunctionModule = "func";  // func.<name>: GOAL address of a function
+constexpr const char* kSegmentModule = "seg";    // seg.<n>: GOAL address of segment n
+constexpr const char* kLinkExport = "__link";    // puts every function in the table
+constexpr int kGoalArgCount = 8;                 // wasm params of every GOAL function
+
+// Header of the wasm module embedded in a wasm-target object file (end of the top-level segment).
+// The top-level function's stub stores the offset from the function to this header.
+constexpr u32 kEmbeddedModuleMagic = 0x4b4a5741;  // "AWJK"
+struct EmbeddedModuleHeader {
+  u32 magic;
+  u32 size;  // bytes of wasm module that follow
+};
+
+/*!
+ * Where functions and statics end up in the object's segments (offsets from the segment start).
+ * With a layout, the module refers to them as seg.<n> + offset, and exports __link, which
+ * adds every function to the table and stores the index in its function object.
+ */
+struct Layout {
+  std::unordered_map<const FunctionEnv*, std::pair<int, int>> functions;  // seg, offset
+  std::unordered_map<const StaticObject*, std::pair<int, int>> statics;   // seg, offset
+};
 
 struct Options {
   bool shared_memory = false;  // the runtime uses a SharedArrayBuffer (pthreads)
@@ -122,18 +147,23 @@ class ModuleGen {
   BinaryenExpressionRef s7();
   BinaryenExpressionRef symbol_addr(const std::string& name);
   BinaryenExpressionRef function_addr(const FunctionEnv* f);
+  BinaryenExpressionRef static_addr(const StaticObject* s);
   std::string export_name(const FunctionEnv* f) const;
+  void set_layout(const Layout* layout) { m_layout = layout; }
 
  private:
   BinaryenExpressionRef import_global(const std::string& module,
                                       const std::string& field,
                                       const std::string& internal);
+  BinaryenExpressionRef segment_addr(int seg, int offset);
+  void add_link_function();
 
   FileEnv* m_env;
   GameVersion m_version;
   Options m_options;
   BinaryenModuleRef m_module;
   std::unordered_map<std::string, std::string> m_imported_globals;  // module.field -> internal
+  const Layout* m_layout = nullptr;
 };
 
 /*!
@@ -141,4 +171,17 @@ class ModuleGen {
  */
 std::vector<u8> codegen_wasm(FileEnv* env, GameVersion version, const Options& options = {});
 
+/*!
+ * Compile a FileEnv to a GOAL object file (v3) for the wasm runtime: the object holds the static
+ * data and an 8-byte function object per function, and embeds the wasm module (see Layout).
+ */
+struct WasmObject {
+  std::vector<u8> object;
+  std::vector<u8> module;
+};
+WasmObject codegen_wasm_object(FileEnv* env,
+                               GameVersion version,
+                               const TypeSystem* ts,
+                               const Options& options = {});
+
 }  // namespace wasm_backend
