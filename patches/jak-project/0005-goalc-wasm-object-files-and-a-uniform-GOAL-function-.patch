 void IR_FunctionCall::do_codegen_wasm(FunctionGen& gen) {
+  // uniform GOAL function type: 8 i64 params, unused ones are zero
   std::vector<BinaryenExpressionRef> args;
-  std::vector<BinaryenType> params;
+  std::vector<BinaryenType> params(wasm_backend::kGoalArgCount, BinaryenTypeInt64());
+  if ((int)m_args.size() > wasm_backend::kGoalArgCount) {
+    gen.unsupported("a call with more than 8 arguments");
+  }
   for (auto* arg : m_args) {
     if (arg->ireg().reg_class != RegClass::GPR_64) {
       gen.unsupported("a 128-bit function argument");
     }
     args.push_back(gen.get(arg));
-    params.push_back(BinaryenTypeInt64());
+  }
+  while ((int)args.size() < wasm_backend::kGoalArgCount) {
+    args.push_back(i64_const(gen, 0));
   }
   if (m_ret->ireg().reg_class != RegClass::GPR_64) {
     gen.unsupported("a 128-bit return value");
@@ -426,5 +432,16 @@ void IR_StaticVarLoad::do_codegen_wasm(FunctionGen& gen) {
     gen.emit(gen.set(m_dest, f32_const(gen, f->value)));
     return;
   }
-  gen.unsupported("loading static data other than a float constant");
+  // other statics (e.g. vector constants) are read from the object's static data
+  auto ptr = gen.goal_addr(gen.mod()->static_addr(m_src));
+  if (is_simd128(m_dest->ireg().reg_class)) {
+    gen.emit(gen.set(m_dest, BinaryenLoad(gen.module(), 16, false, gen.mem_offset(0), 1,
+                                          BinaryenTypeVec128(), ptr, wasm_backend::kMemoryName)));
+    return;
+  }
+  gen.unsupported("loading this kind of static data");
+}
+
+void IR_StaticVarAddr::do_codegen_wasm(FunctionGen& gen) {
+  gen.emit(gen.set(m_dest, gen.mod()->static_addr(m_src)));
 }
