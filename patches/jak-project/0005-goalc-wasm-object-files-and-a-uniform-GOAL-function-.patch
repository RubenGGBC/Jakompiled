 goalc/compiler/IR_wasm.cpp      |  23 ++++-
 goalc/emitter/ObjectGenerator.h |   4 +
 goalc/wasm/WasmCodegen.cpp      | 162 +++++++++++++++++++++++++++++++-
 goalc/wasm/WasmCodegen.h        |  45 ++++++++-
 goalc/wasm/goalc_wasm_main.cpp  |  25 ++++-
 6 files changed, 250 insertions(+), 10 deletions(-)

