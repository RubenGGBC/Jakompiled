+BinaryenExpressionRef ModuleGen::segment_addr(int seg, int offset) {
+  static const char* kSegNames[N_SEG] = {"main", "debug", "top-level"};
+  auto base = import_global(kSegmentModule, kSegNames[seg], fmt::format("seg:{}", kSegNames[seg]));
+  return BinaryenBinary(m_module, BinaryenAddInt64(), base,
+                        BinaryenConst(m_module, BinaryenLiteralInt64(offset)));
+}
+
 BinaryenExpressionRef ModuleGen::function_addr(const FunctionEnv* f) {
+  if (m_layout) {
+    auto& [seg, offset] = m_layout->functions.at(f);
+    return segment_addr(seg, offset);
+  }
   auto name = export_name(f);
   return import_global(kFunctionModule, name, "func:" + name);
 }
 
+BinaryenExpressionRef ModuleGen::static_addr(const StaticObject* s) {
+  if (!m_layout) {
+    throw std::runtime_error("wasm backend: static data needs an object layout (goalc-wasm -o)");
+  }
+  auto& [seg, offset] = m_layout->statics.at(s);
+  return segment_addr(seg, offset + s->get_addr_offset());
+}
+
+/*!
+ * __link(): add every function of the module to the table and store its index in the function
+ * object, so that GOAL code (and the runtime) can call it through call_indirect.
+ */
+void ModuleGen::add_link_function() {
+  std::vector<BinaryenExpressionRef> body;
+  for (auto& f : m_env->functions()) {
+    auto name = export_name(f.get());
+    auto func_ref = BinaryenRefFunc(m_module, name.c_str(),
+                                    BinaryenFunctionGetType(BinaryenGetFunction(m_module, name.c_str())));
+    auto index = BinaryenTableGrow(m_module, kTableName, func_ref,
+                                   BinaryenConst(m_module, BinaryenLiteralInt32(1)));
+    auto addr = BinaryenUnary(m_module, BinaryenWrapInt64(), function_addr(f.get()));
+    body.push_back(BinaryenStore(m_module, 4, WASM_EE_MAIN_MEM_BASE, 4, addr, index,
+                                 BinaryenTypeInt32(), kMemoryName));
+  }
+  auto block = BinaryenBlock(m_module, nullptr, body.data(), (BinaryenIndex)body.size(),
+                             BinaryenTypeNone());
+  BinaryenAddFunction(m_module, kLinkExport, BinaryenTypeNone(), BinaryenTypeNone(), nullptr, 0,
+                      block);
+  BinaryenAddFunctionExport(m_module, kLinkExport, kLinkExport);
+}
+
 std::string ModuleGen::export_name(const FunctionEnv* f) const {
   return f->name();
 }
@@ -291,6 +349,9 @@ std::vector<u8> ModuleGen::run() {
     FunctionGen fg(this, f.get());
     fg.run();
   }
+  if (m_layout) {
+    add_link_function();
+  }
 
   if (!BinaryenModuleValidate(m_module)) {
     throw std::runtime_error("wasm backend: generated module failed validation");
@@ -314,4 +375,103 @@ std::vector<u8> codegen_wasm(FileEnv* env, GameVersion version, const Options& o
   return gen.run();
 }
 
+namespace {
+// klink starts an object at the first function of the top-level segment
+const FunctionEnv* top_level_function(FileEnv* env) {
+  for (auto& f : env->functions()) {
+    if (f->segment == TOP_LEVEL_SEGMENT) {
+      return f.get();
+    }
+  }
+  throw std::runtime_error("wasm backend: object has no top-level function");
+}
+
+/*!
+ * Lay out a wasm-target object: an 8-byte function object per function (table index, then the
+ * offset to the embedded module for the top-level function), the statics, and the module at the
+ * end of the top-level segment. Functions and statics come before the module, so their offsets
+ * don't depend on its size.
+ */
+std::vector<u8> build_object(FileEnv* env,
+                             GameVersion version,
+                             const TypeSystem* ts,
+                             const std::vector<u8>& module,
+                             u32 top_level_module_offset,
+                             Layout* layout_out,
+                             int* module_location_out) {
+  emitter::ObjectGenerator gen(version, emitter::InstructionSet::X86);
+  DebugInfo debug(env->name());
+  std::vector<emitter::FunctionRecord> recs;
+  for (auto& f : env->functions()) {
+    auto rec = gen.add_function_to_seg(f->segment, &debug.add_function(f->name(), env->name()));
+    const bool top_level = (f.get() == top_level_function(env));
+    const u32 aux = top_level ? top_level_module_offset : 0;
+    gen.add_instr_no_ir(rec,
+                        emitter::InstructionARM64(emitter::InstructionARM64(u32(0)),
+                                                  emitter::InstructionARM64(aux)),
+                        InstructionInfo::Kind::PROLOGUE);
+    recs.push_back(rec);
+  }
+  for (auto& st : env->statics()) {
+    st->generate(&gen);
+  }
+  auto module_rec = gen.add_static_to_seg(TOP_LEVEL_SEGMENT, 16);
+  auto& module_data = gen.get_static_data(module_rec);
+  EmbeddedModuleHeader header{kEmbeddedModuleMagic, (u32)module.size()};
+  module_data.resize(sizeof(header) + module.size());
+  memcpy(module_data.data(), &header, sizeof(header));
+  if (!module.empty()) {
+    memcpy(module_data.data() + sizeof(header), module.data(), module.size());
+  }
+
+  auto data = gen.generate_data_v3(ts);
+
+  if (layout_out) {
+    for (size_t i = 0; i < env->functions().size(); i++) {
+      auto& f = env->functions()[i];
+      auto& dbg = debug.function_by_name(f->name());
+      layout_out->functions[f.get()] = {dbg.seg, (int)dbg.offset_in_seg};
+    }
+    for (auto& st : env->statics()) {
+      layout_out->statics[st.get()] = {st->rec.seg, gen.static_location(st->rec)};
+    }
+  }
+  if (module_location_out) {
+    *module_location_out = gen.static_location(module_rec);
+  }
+  return data.to_vector();
+}
+}  // namespace
+
+WasmObject codegen_wasm_object(FileEnv* env,
+                               GameVersion version,
+                               const TypeSystem* ts,
+                               const Options& options) {
+  // pass 1: layout, with an empty module
+  Layout layout;
+  int module_location = -1;
+  build_object(env, version, ts, {}, 0, &layout, &module_location);
+
+  // the module refers to functions and statics through that layout
+  ModuleGen mod(env, version, options);
+  mod.set_layout(&layout);
+  WasmObject result;
+  result.module = mod.run();
+
+  // pass 2: the final object, with the module embedded
+  auto& [tl_seg, tl_offset] = layout.functions.at(top_level_function(env));
+  if (tl_seg != TOP_LEVEL_SEGMENT || tl_offset != 4) {
+    throw std::runtime_error("wasm backend: top-level function is not the object's entry point");
+  }
+  Layout check;
+  int check_location = -1;
+  result.object = build_object(env, version, ts, result.module,
+                               (u32)(module_location - tl_offset), &check, &check_location);
+  if (check_location != module_location || check.functions != layout.functions ||
+      check.statics != layout.statics) {
+    throw std::runtime_error("wasm backend: object layout changed between passes");
+  }
+  return result;
+}
+
 }  // namespace wasm_backend
