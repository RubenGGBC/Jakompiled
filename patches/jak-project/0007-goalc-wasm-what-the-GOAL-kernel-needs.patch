 };
 
 class IR_AsmFNop : public IR_Asm {
diff --git a/goalc/compiler/IR_wasm.cpp b/goalc/compiler/IR_wasm.cpp
index cf58239d..f6ac5f71 100644
--- a/goalc/compiler/IR_wasm.cpp
+++ b/goalc/compiler/IR_wasm.cpp
@@ -445,3 +445,12 @@ void IR_StaticVarLoad::do_codegen_wasm(FunctionGen& gen) {
 void IR_StaticVarAddr::do_codegen_wasm(FunctionGen& gen) {
   gen.emit(gen.set(m_dest, gen.mod()->static_addr(m_src)));
 }
+
+void IR_GetStackAddr::do_codegen_wasm(FunctionGen& gen) {
+  gen.emit(gen.set(m_dest, gen.stack_slot_addr(m_slot)));
+}
+
+void IR_AsmBreak::do_codegen_wasm(FunctionGen& gen) {
+  // (break): an exception on x86 (int3), a trap in wasm
+  gen.emit(BinaryenUnreachable(gen.module()));
+}
