   Compiler compiler(version, emitter::InstructionSet::X86);
+  // GOAL source can select wasm-specific code with (#cond ((eq? INSTRUCTION_SET 'wasm) ...))
+  compiler.get_goos().set_global_variable_to_symbol("INSTRUCTION_SET", "wasm");
