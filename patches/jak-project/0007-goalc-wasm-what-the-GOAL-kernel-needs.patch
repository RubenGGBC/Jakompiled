@@ -79,14 +80,39 @@ BinaryenType FunctionGen::type_of(const RegVal* rv) const {
   return wasm_type_for_class(rv->ireg().reg_class);
 }
 
+bool FunctionGen::is_pp(const RegVal* rv) const {
+  return m_pp_iregs.count(rv->ireg().id) > 0;
+}
+
 BinaryenExpressionRef FunctionGen::get(const RegVal* rv) {
+  if (is_pp(rv)) {
+    return m_mod->get_pp();
+  }
+  if (m_st_iregs.count(rv->ireg().id)) {
+    return m_mod->s7();
+  }
   return BinaryenLocalGet(module(), local_index(rv), type_of(rv));
 }
 
 BinaryenExpressionRef FunctionGen::set(const RegVal* rv, BinaryenExpressionRef value) {
+  if (is_pp(rv)) {
+    return m_mod->set_pp(value);
+  }
+  if (m_st_iregs.count(rv->ireg().id)) {
+    unsupported("writing the symbol table register");
+  }
   return BinaryenLocalSet(module(), local_index(rv), value);
 }
 
+BinaryenExpressionRef FunctionGen::stack_slot_addr(int slot) {
+  if (m_frame_base_local < 0 || slot * 8 >= m_stack_frame_size) {
+    throw std::runtime_error("wasm backend: stack slot outside of the function's frame");
+  }
+  return BinaryenBinary(module(), BinaryenAddInt64(),
+                        BinaryenLocalGet(module(), m_frame_base_local, BinaryenTypeInt64()),
+                        BinaryenConst(module(), BinaryenLiteralInt64(slot * 8)));
+}
+
 BinaryenExpressionRef FunctionGen::goal_addr(BinaryenExpressionRef goal_ptr_i64) {
   return BinaryenUnary(module(), BinaryenWrapInt64(), goal_ptr_i64);
 }
