+void FunctionGen::emit_trap_stub() {
+  std::vector<BinaryenType> params(kGoalArgCount, BinaryenTypeInt64());
+  auto name = m_mod->export_name(m_env);
+  BinaryenAddFunction(module(), name.c_str(),
+                      BinaryenTypeCreate(params.data(), (BinaryenIndex)params.size()),
+                      BinaryenTypeInt64(), nullptr, 0, BinaryenUnreachable(module()));
+  BinaryenAddFunctionExport(module(), name.c_str(), name.c_str());
+}
+
 void FunctionGen::run() {
   const auto& code = m_env->code();
 
+  // registers pinned to a physical register for the whole function: pp becomes the pp global,
+  // anything else is x86-specific code that has no wasm meaning
+  for (auto& c : m_env->constraints()) {
+    if (!c.contrain_everywhere) {
+      continue;
+    }
+    if (c.desired_register == emitter::R13) {
+      m_pp_iregs[c.ireg.id] = true;
+    } else if (c.desired_register == emitter::R14) {
+      m_st_iregs[c.ireg.id] = true;  // symbol table register: s7
+    } else {
+      unsupported(fmt::format("a variable pinned to register {}", c.desired_register.print(emitter::InstructionSet::X86)));
+    }
+  }
+
   // the arguments have to be known before any other local is created
   bool has_params = false;
   for (auto& ir : code) {
@@ -158,6 +211,25 @@ void FunctionGen::run() {
     set_params({});
   }
 
+  // stack variables: reserve a 16-byte aligned frame on the GOAL stack
+  m_stack_frame_size = m_env->stack_slots_used_for_stack_vars() * 8;
+  std::vector<BinaryenExpressionRef> prologue;
+  if (m_stack_frame_size > 0) {
+    m_saved_sp_local = (int)m_local_types.size();
+    m_local_types.push_back(BinaryenTypeInt64());
+    m_frame_base_local = (int)m_local_types.size();
+    m_local_types.push_back(BinaryenTypeInt64());
+    prologue.push_back(BinaryenLocalSet(module(), m_saved_sp_local, m_mod->get_sp()));
+    auto new_sp = BinaryenBinary(
+        module(), BinaryenAndInt64(),
+        BinaryenBinary(module(), BinaryenSubInt64(), m_mod->get_sp(),
+                       BinaryenConst(module(), BinaryenLiteralInt64(m_stack_frame_size))),
+        BinaryenConst(module(), BinaryenLiteralInt64(-16)));
+    prologue.push_back(BinaryenLocalSet(module(), m_frame_base_local, new_sp));
+    prologue.push_back(
+        m_mod->set_sp(BinaryenLocalGet(module(), m_frame_base_local, BinaryenTypeInt64())));
+  }
+
   // basic block leaders: function start, branch targets and instructions after a branch
   std::set<int> leaders = {0};
   for (int i = 0; i < (int)code.size(); i++) {
@@ -198,8 +270,15 @@ void FunctionGen::run() {
     blocks[b].falls_through = m_cur_falls_through;
   }
 
+  // prologue at the start of the entry block
+  blocks.front().exprs.insert(blocks.front().exprs.begin(), prologue.begin(), prologue.end());
+
   // the exit block returns the return register (functions returning none return 0)
   auto& exit_block = blocks.back();
+  if (m_stack_frame_size > 0) {
+    exit_block.exprs.push_back(
+        m_mod->set_sp(BinaryenLocalGet(module(), m_saved_sp_local, BinaryenTypeInt64())));
+  }
   if (m_return_reg) {
     exit_block.exprs.push_back(BinaryenReturn(module(), get(m_return_reg)));
   } else {
@@ -285,6 +364,34 @@ BinaryenExpressionRef ModuleGen::s7() {
   return import_global(kEnvModule, kS7Global, "s7");
 }
 
+void ModuleGen::import_mutable_global(const char* name) {
+  auto key = std::string(kEnvModule) + "." + name;
+  if (m_imported_globals.find(key) == m_imported_globals.end()) {
+    BinaryenAddGlobalImport(m_module, name, kEnvModule, name, BinaryenTypeInt64(), true);
+    m_imported_globals[key] = name;
+  }
+}
+
+BinaryenExpressionRef ModuleGen::get_pp() {
+  import_mutable_global(kPPGlobal);
+  return BinaryenGlobalGet(m_module, kPPGlobal, BinaryenTypeInt64());
+}
+
+BinaryenExpressionRef ModuleGen::set_pp(BinaryenExpressionRef value) {
+  import_mutable_global(kPPGlobal);
+  return BinaryenGlobalSet(m_module, kPPGlobal, value);
+}
+
+BinaryenExpressionRef ModuleGen::get_sp() {
+  import_mutable_global(kSPGlobal);
+  return BinaryenGlobalGet(m_module, kSPGlobal, BinaryenTypeInt64());
+}
+
+BinaryenExpressionRef ModuleGen::set_sp(BinaryenExpressionRef value) {
+  import_mutable_global(kSPGlobal);
+  return BinaryenGlobalSet(m_module, kSPGlobal, value);
+}
+
 BinaryenExpressionRef ModuleGen::symbol_addr(const std::string& name) {
   return import_global(kSymbolModule, name, "sym:" + name);
 }
