 goalc/compiler/IR_wasm.cpp     |   9 +++
 goalc/wasm/WasmCodegen.cpp     | 141 +++++++++++++++++++++++++++++++--
 goalc/wasm/WasmCodegen.h       |  28 +++++++
 goalc/wasm/goalc_wasm_main.cpp |  51 +++++++++++-
 5 files changed, 225 insertions(+), 6 deletions(-)

