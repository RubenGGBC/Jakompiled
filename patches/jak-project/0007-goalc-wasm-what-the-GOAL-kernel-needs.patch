 std::vector<u8> ModuleGen::run() {
+  bool failed = false;
   for (auto& f : m_env->functions()) {
-    if (f->is_asm_func) {
-      throw std::runtime_error(
-          fmt::format("wasm backend: asm-func {} needs a hand-written wasm version", f->name()));
+    try {
+      if (f->is_asm_func) {
+        throw std::runtime_error(
+            fmt::format("wasm backend: asm-func {} needs a hand-written wasm version", f->name()));
+      }
+      FunctionGen fg(this, f.get());
+      fg.run();
+    } catch (std::exception& e) {
+      if (!m_options.unsupported_report) {
