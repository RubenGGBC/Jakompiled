+        auto name = export_name(f.get());
+        if (BinaryenGetFunction(m_module, name.c_str())) {
+          BinaryenRemoveExport(m_module, name.c_str());
+          BinaryenRemoveFunction(m_module, name.c_str());
+        }
+        FunctionGen(this, f.get()).emit_trap_stub();
+      } else {
+        failed = true;
+      }
     }
-    FunctionGen fg(this, f.get());
-    fg.run();
+  }
+  if (failed) {
+    throw std::runtime_error(fmt::format("wasm backend: {} has unsupported code", m_env->name()));
   }
   if (m_layout) {
     add_link_function();
@@ -361,6 +490,8 @@ std::vector<u8> ModuleGen::run() {
     BinaryenSetShrinkLevel(0);
