+// ---- 128-bit vector float (vf) and integer instructions, matching the AVX instructions of IGen
+
+namespace {
+
+BinaryenExpressionRef shuffle(FunctionGen& g,
+                              BinaryenExpressionRef a,
+                              BinaryenExpressionRef b,
+                              const uint8_t (&mask)[16]) {
+  return BinaryenSIMDShuffle(g.module(), a, b, mask);
+}
+
+// byte shuffle mask from 32-bit lane indices (0-3: a, 4-7: b)
+void lanes32(uint8_t (&mask)[16], const int (&lanes)[4]) {
+  for (int i = 0; i < 4; i++) {
+    for (int j = 0; j < 4; j++) {
+      mask[i * 4 + j] = (uint8_t)(lanes[i] * 4 + j);
+    }
+  }
+}
+
+// x86 punpck{l,h}{bw,wd,dq,qdq} a, b: interleave the low/high halves, a first
+BinaryenExpressionRef unpack(FunctionGen& g,
+                             BinaryenExpressionRef a,
+                             BinaryenExpressionRef b,
+                             int elt_bytes,
+                             bool high) {
+  uint8_t mask[16];
+  const int n = 16 / elt_bytes / 2;  // elements taken from each source
+  for (int i = 0; i < n; i++) {
+    const int src_elt = (high ? n : 0) + i;
+    for (int j = 0; j < elt_bytes; j++) {
+      mask[(2 * i) * elt_bytes + j] = (uint8_t)(src_elt * elt_bytes + j);
+      mask[(2 * i + 1) * elt_bytes + j] = (uint8_t)(16 + src_elt * elt_bytes + j);
+    }
+  }
+  return shuffle(g, a, b, mask);
+}
+
+BinaryenExpressionRef v128_const(FunctionGen& g, const uint8_t (&bytes)[16]) {
+  return BinaryenConst(g.module(), BinaryenLiteralVec128(bytes));
+}
+
+BinaryenExpressionRef splat_i32(FunctionGen& g, s32 v) {
+  return unary(g, BinaryenSplatVecI32x4(), i32_const(g, v));
+}
+
+BinaryenExpressionRef splat_f32(FunctionGen& g, float v) {
+  return unary(g, BinaryenSplatVecF32x4(), f32_const(g, v));
+}
+
+BinaryenExpressionRef zero_v128(FunctionGen& g) {
+  uint8_t zero[16] = {};
+  return v128_const(g, zero);
+}
+
+}  // namespace
+
+void IR_VFMath3Asm::do_codegen_wasm(FunctionGen& gen) {
+  auto a = [&]() { return gen.get(m_src1); };
+  auto b = [&]() { return gen.get(m_src2); };
+  BinaryenExpressionRef r = nullptr;
+  switch (m_kind) {
+    case Kind::XOR:
+      r = binary(gen, BinaryenXorVec128(), a(), b());
+      break;
+    case Kind::SUB:
+      r = binary(gen, BinaryenSubVecF32x4(), a(), b());
+      break;
+    case Kind::ADD:
+      r = binary(gen, BinaryenAddVecF32x4(), a(), b());
+      break;
+    case Kind::MUL:
+      r = binary(gen, BinaryenMulVecF32x4(), a(), b());
+      break;
+    case Kind::DIV:
+      r = binary(gen, BinaryenDivVecF32x4(), a(), b());
+      break;
+    // vmaxps a, b = a > b ? a : b (b if either is NaN); f32x4.pmax(x, y) = x < y ? y : x
+    case Kind::MAX:
+      r = binary(gen, BinaryenPMaxVecF32x4(), b(), a());
+      break;
+    // vminps a, b = a < b ? a : b; f32x4.pmin(x, y) = y < x ? y : x
+    case Kind::MIN:
+      r = binary(gen, BinaryenPMinVecF32x4(), b(), a());
+      break;
+    default:
+      gen.unsupported("this vf math operation");
+  }
+  gen.emit(gen.set(m_dst, r));
+}
+
+void IR_VFMath2Asm::do_codegen_wasm(FunctionGen& gen) {
+  auto x = [&]() { return gen.get(m_src); };
+  BinaryenExpressionRef r = nullptr;
+  switch (m_kind) {
+    case Kind::ITOF:
+      // vcvtdq2ps
+      r = unary(gen, BinaryenConvertSVecI32x4ToVecF32x4(), x());
+      break;
+    case Kind::FTOI: {
+      // vcvttps2dq: NaN and out of range lanes give 0x80000000
+      auto in_range =
+          binary(gen, BinaryenAndVec128(),
+                 binary(gen, BinaryenLtVecF32x4(), x(), splat_f32(gen, 2147483648.0f)),
+                 binary(gen, BinaryenGeVecF32x4(), x(), splat_f32(gen, -2147483648.0f)));
+      r = BinaryenSIMDTernary(gen.module(), BinaryenBitselectVec128(),
+                              unary(gen, BinaryenTruncSatSVecF32x4ToVecI32x4(), x()),
+                              splat_i32(gen, INT32_MIN), in_range);
+    } break;
+    default:
+      gen.unsupported("this vf conversion");
+  }
+  gen.emit(gen.set(m_dst, r));
+}
+
+void IR_BlendVF::do_codegen_wasm(FunctionGen& gen) {
+  // vblendps: lane i from src2 if bit i of the mask is set, else from src1
+  int lanes[4];
+  for (int i = 0; i < 4; i++) {
+    lanes[i] = (m_mask & (1 << i)) ? 4 + i : i;
+  }
+  uint8_t mask[16];
+  lanes32(mask, lanes);
+  gen.emit(gen.set(m_dst, shuffle(gen, gen.get(m_src1), gen.get(m_src2), mask)));
+}
+
+void IR_SplatVF::do_codegen_wasm(FunctionGen& gen) {
+  int lane = 0;
+  switch (m_element) {
+    case emitter::Register::VF_ELEMENT::X:
+      lane = 0;
+      break;
+    case emitter::Register::VF_ELEMENT::Y:
+      lane = 1;
+      break;
+    case emitter::Register::VF_ELEMENT::Z:
+      lane = 2;
+      break;
+    case emitter::Register::VF_ELEMENT::W:
+      lane = 3;
+      break;
+    default:
+      gen.unsupported("splat of this element");
+  }
+  int lanes[4] = {lane, lane, lane, lane};
+  uint8_t mask[16];
+  lanes32(mask, lanes);
+  gen.emit(gen.set(m_dst, shuffle(gen, gen.get(m_src), gen.get(m_src), mask)));
+}
+
+void IR_SwizzleVF::do_codegen_wasm(FunctionGen& gen) {
+  // vshufps src, src, imm: lane i = src[(imm >> 2i) & 3]
+  int lanes[4];
+  for (int i = 0; i < 4; i++) {
+    lanes[i] = (m_controlBytes >> (2 * i)) & 3;
+  }
+  uint8_t mask[16];
+  lanes32(mask, lanes);
+  gen.emit(gen.set(m_dst, shuffle(gen, gen.get(m_src), gen.get(m_src), mask)));
+}
+
+void IR_SqrtVF::do_codegen_wasm(FunctionGen& gen) {
+  gen.emit(gen.set(m_dst, unary(gen, BinaryenSqrtVecF32x4(), gen.get(m_src))));
+}
+
+void IR_Int128Math3Asm::do_codegen_wasm(FunctionGen& gen) {
+  // operands as IR_Int128Math3Asm::do_codegen_x86 passes them to the AVX instruction
+  auto s1 = [&]() { return gen.get(m_src1); };
+  auto s2 = [&]() { return gen.get(m_src2); };
+  BinaryenExpressionRef r = nullptr;
+  switch (m_kind) {
+    case Kind::PEXTUB:
+      r = unpack(gen, s2(), s1(), 1, true);
+      break;
+    case Kind::PEXTUH:
+      r = unpack(gen, s2(), s1(), 2, true);
+      break;
+    case Kind::PEXTUW:
+      r = unpack(gen, s2(), s1(), 4, true);
+      break;
+    case Kind::PEXTLB:
+      r = unpack(gen, s2(), s1(), 1, false);
+      break;
+    case Kind::PEXTLH:
+      r = unpack(gen, s2(), s1(), 2, false);
+      break;
+    case Kind::PEXTLW:
+      r = unpack(gen, s2(), s1(), 4, false);
+      break;
+    case Kind::PCPYLD:
+      r = unpack(gen, s2(), s1(), 8, false);  // vpunpcklqdq src2, src1
+      break;
+    case Kind::PCPYUD:
+      r = unpack(gen, s1(), s2(), 8, true);  // vpunpckhqdq src1, src2
+      break;
+    case Kind::PSUBW:
+      r = binary(gen, BinaryenSubVecI32x4(), s1(), s2());
+      break;
+    case Kind::PCEQB:
+      r = binary(gen, BinaryenEqVecI8x16(), s2(), s1());
+      break;
+    case Kind::PCEQH:
+      r = binary(gen, BinaryenEqVecI16x8(), s2(), s1());
+      break;
+    case Kind::PCEQW:
+      r = binary(gen, BinaryenEqVecI32x4(), s2(), s1());
+      break;
+    case Kind::PCGTB:
+      r = binary(gen, BinaryenGtSVecI8x16(), s1(), s2());
+      break;
+    case Kind::PCGTH:
+      r = binary(gen, BinaryenGtSVecI16x8(), s1(), s2());
+      break;
+    case Kind::PCGTW:
+      r = binary(gen, BinaryenGtSVecI32x4(), s1(), s2());
+      break;
+    case Kind::POR:
+      r = binary(gen, BinaryenOrVec128(), s2(), s1());
+      break;
+    case Kind::PXOR:
+      r = binary(gen, BinaryenXorVec128(), s2(), s1());
+      break;
+    case Kind::PAND:
+      r = binary(gen, BinaryenAndVec128(), s2(), s1());
+      break;
+    case Kind::PACKUSWB:
+      // signed words -> unsigned saturated bytes, src1 in the low half
+      r = binary(gen, BinaryenNarrowUVecI16x8ToVecI8x16(), s1(), s2());
+      break;
+    case Kind::PADDB:
+      r = binary(gen, BinaryenAddVecI8x16(), s1(), s2());
+      break;
+    default:
+      gen.unsupported("this 128-bit integer operation");
+  }
+  gen.emit(gen.set(m_dst, r));
+}
+
+void IR_Int128Math2Asm::do_codegen_wasm(FunctionGen& gen) {
+  if (!m_imm.has_value() || *m_imm < 0 || *m_imm > 255) {
+    gen.unsupported("a 128-bit integer operation without a valid immediate");
+  }
+  const int imm = (int)*m_imm;
+  auto x = [&]() { return gen.get(m_src); };
+  // AVX shifts by an immediate >= the lane width give 0 (sra: the sign); wasm takes it modulo
+  auto shift = [&](BinaryenOp op, int lane_bits, bool arith) -> BinaryenExpressionRef {
+    if (imm >= lane_bits) {
+      if (!arith) {
+        return zero_v128(gen);
+      }
+      return BinaryenSIMDShift(gen.module(), op, x(), i32_const(gen, lane_bits - 1));
+    }
+    return BinaryenSIMDShift(gen.module(), op, x(), i32_const(gen, imm));
+  };
+  BinaryenExpressionRef r = nullptr;
+  switch (m_kind) {
+    case Kind::PW_SLL:
+      r = shift(BinaryenShlVecI32x4(), 32, false);
+      break;
+    case Kind::PW_SRL:
+      r = shift(BinaryenShrUVecI32x4(), 32, false);
+      break;
+    case Kind::PW_SRA:
+      r = shift(BinaryenShrSVecI32x4(), 32, true);
+      break;
+    case Kind::PH_SLL:
+      r = shift(BinaryenShlVecI16x8(), 16, false);
+      break;
+    case Kind::PH_SRL:
+      r = shift(BinaryenShrUVecI16x8(), 16, false);
+      break;
+    case Kind::VPSRLDQ:
+    case Kind::VPSLLDQ: {
+      // byte shift of the whole register, zeros shifted in (bytes 16-31 of the shuffle)
+      const int n = imm > 16 ? 16 : imm;
+      uint8_t mask[16];
+      for (int i = 0; i < 16; i++) {
+        int src = (m_kind == Kind::VPSRLDQ) ? i + n : i - n;
+        mask[i] = (src >= 0 && src < 16) ? (uint8_t)src : (uint8_t)16;
+      }
+      r = shuffle(gen, x(), zero_v128(gen), mask);
+    } break;
+    case Kind::VPSHUFLW:
+    case Kind::VPSHUFHW: {
+      // shuffle the 4 words of one half by imm, keep the other half
+      const int base = (m_kind == Kind::VPSHUFLW) ? 0 : 4;
+      int words[8];
+      for (int i = 0; i < 8; i++) {
+        words[i] = i;
+      }
+      for (int i = 0; i < 4; i++) {
+        words[base + i] = base + ((imm >> (2 * i)) & 3);
+      }
+      uint8_t mask[16];
+      for (int i = 0; i < 8; i++) {
