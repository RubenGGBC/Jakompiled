 // Shared by the runtime (Emscripten build) and goalc's wasm backend.
 constexpr u32 WASM_EE_MAIN_MEM_BASE = 0x01000000;
+// 128-bit arguments and return values of GOAL functions in wasm. The uniform GOAL function type
+// only has i64 params, so a 128-bit argument i is passed in slot i of this area (wasm address,
+// below the EE memory) and a 128-bit return value in slot 8. Only the EE thread runs GOAL code.
+constexpr u32 WASM_SIMD_ARG_AREA = 0x00F00000;
+constexpr u32 WASM_SIMD_RET_SLOT = 8;
