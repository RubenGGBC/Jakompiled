index 00000000..a9808ae4
--- /dev/null
+++ b/web/build_game_web.cpp
@@ -0,0 +1,210 @@
+// Jakompiled web: builds the game's files in the browser, after the extractor has decompiled the
+// user's ISO. It does what goalc's (mi) does in the native build, minus compiling code:
+//
+//  - dir-tpages.go, the game text (*COMMON.TXT) and subtitles (*SUBTI2.TXT): OpenGOAL's own data
+//    compiler (goalc/data_compiler), from the decompiler's output and the project's assets
+//  - every DGO/CGO of goal_src/jak2/dgos/*.gd, like the "dgo" make tool: code objects come from
+//    /data/CODE.PAK (all the game's code, compiled to wasm ahead of time and served with the page),
+//    data objects from the decompiler's raw_obj (the user's ISO)
+//
+// Everything is written under /data/out (OPFS, see web/extract_web.cpp).
+
+#include <cstring>
+#include <regex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/log/log.h"
+#include "common/serialization/subtitles/subtitles.h"
+#include "common/serialization/text/text_ser.h"
+#include "common/util/BinaryWriter.h"
+#include "common/util/FileUtil.h"
+
+#include "goalc/data_compiler/dir_tpages.h"
+#include "goalc/data_compiler/game_text_common.h"
+
+namespace {
+
+const std::string kGame = "jak2";
+
+std::string remap(const std::string& path) {
+  // the $DECOMP of the make system
+  const std::string decomp = "$DECOMP/";
+  if (path.rfind(decomp, 0) == 0) {
+    return "decompiler_out/" + kGame + "/" + path.substr(decomp.size());
+  }
+  return path;
+}
+
+// CODE.PAK: same layout as a DGO (backend/make_dgo.py), one entry per code object
+std::unordered_map<std::string, std::vector<u8>> read_code_pack(const fs::path& path) {
+  std::unordered_map<std::string, std::vector<u8>> result;
+  auto data = file_util::read_binary_file(path);
+  size_t pos = 0;
+  auto u32_at = [&](size_t p) {
+    u32 v;
+    memcpy(&v, data.data() + p, 4);
+    return v;
+  };
+  const u32 count = u32_at(0);
+  pos = 64;
+  for (u32 i = 0; i < count; i++) {
+    const u32 size = u32_at(pos);
+    std::string name((const char*)data.data() + pos + 4);
+    pos += 64;
+    result[name] = std::vector<u8>(data.begin() + pos, data.begin() + pos + size);
+    pos += size;
+    pos = (pos + 15) & ~size_t(15);
+  }
+  return result;
+}
+
+// name of an object inside a DGO, as goalc/make/Tools.cpp (DgoTool) deduces it
+std::string name_in_dgo(const std::string& file) {
+  auto ends_with = [&](const std::string& suffix) {
+    return file.size() > suffix.size() &&
+           file.compare(file.size() - suffix.size(), suffix.size(), suffix) == 0;
+  };
+  if (ends_with(".o")) {
+    return file.substr(0, file.size() - 2);
+  }
+  if (ends_with("-ag.go")) {
+    return file.substr(0, file.size() - 6);
+  }
+  if (ends_with(".go")) {
+    return file.substr(0, file.size() - 3);
+  }
+  return file;
+}
+
+int build_dgos(const std::unordered_map<std::string, std::vector<u8>>& code) {
+  const auto proj = file_util::get_jak_project_dir();
+  const auto gd_dir = proj / "goal_src" / kGame / "dgos";
+  const auto raw_obj = proj / "decompiler_out" / kGame / "raw_obj";
+  const auto generated = proj / "out" / kGame / "obj";
+  const auto iso_out = proj / "out" / kGame / "iso";
+  fs::create_directories(iso_out);
+
+  int built = 0;
+  int missing = 0;
+  const std::regex quoted("\"([^\"]+)\"");
+  for (const auto& entry : fs::directory_iterator(gd_dir)) {
+    if (entry.path().extension() != ".gd") {
+      continue;
+    }
+    const auto text = file_util::read_text_file(entry.path());
+    std::vector<std::string> names;
+    for (auto it = std::sregex_iterator(text.begin(), text.end(), quoted);
+         it != std::sregex_iterator(); ++it) {
+      names.push_back((*it)[1].str());
+    }
+    if (names.empty()) {
+      continue;
+    }
+    const std::string dgo_name = names[0];
+
+    BinaryWriter writer;
+    writer.add<uint32_t>(0);  // object count, patched below
+    writer.add_cstr_len(dgo_name.c_str(), 60);
+    u32 count = 0;
+    for (size_t i = 1; i < names.size(); i++) {
+      const auto& file = names[i];
+      std::vector<u8> obj;
+      if (file.size() > 2 && file.compare(file.size() - 2, 2, ".o") == 0) {
+        auto it = code.find(name_in_dgo(file));
+        if (it == code.end()) {
+          // collide-planes.o has no source in Jak 2 (the original was empty): the native build
+          // skips it with the same warning
+          lg::warn("{}: no code object {} (not in CODE.PAK)", dgo_name, file);
+          if (file != "collide-planes.o") {
+            missing++;
+          }
+          continue;
+        }
+        obj = it->second;
+      } else if (fs::exists(generated / file)) {
+        obj = file_util::read_binary_file(generated / file);  // dir-tpages.go
+      } else if (fs::exists(raw_obj / file)) {
+        obj = file_util::read_binary_file(raw_obj / file);
+      } else {
+        lg::warn("{}: data object {} wasn't extracted", dgo_name, file);
+        missing++;
+        continue;
+      }
+      writer.add<uint32_t>(obj.size());
+      writer.add_str_len(name_in_dgo(file), 60);
+      writer.add_data(obj.data(), obj.size());
+      while (writer.get_size() & 0xf) {
+        writer.add<uint8_t>(0);
+      }
+      count++;
+    }
+    memcpy(writer.get_data(), &count, 4);
+    writer.write_to_file(iso_out / dgo_name);
+    built++;
+  }
+  lg::info("[build] {} DGO/CGO files, {} missing objects", built, missing);
+  return missing;
+}
+
+}  // namespace
+
+namespace jakompiled {
+
+// returns the number of steps that failed (0: everything built)
+int build_game_files() {
+  const auto proj = file_util::get_jak_project_dir();
+  int failed = 0;
+  auto step = [&](const char* what, auto&& fn) {
+    lg::info("[build] {}", what);
+    try {
+      fn();
+    } catch (std::exception& e) {
+      lg::error("[build] {} failed: {}", what, e.what());
+      failed++;
+    }
+  };
+
+  step("texture directory",
+       [&] { compile_dir_tpages(remap("$DECOMP/textures/tpage-dir.txt"), kGame); });
+
+  step("game text", [&] {
+    GameTextDB db;
+    std::vector<GameTextDefinitionFile> files;
+    open_text_project("text", "game/assets/jak2/game_text.gp", files);
+    for (auto& file : files) {
+      file.file_path = remap(file.file_path);
+    }
+    compile_game_text(files, db, kGame);
+  });
+
+  step("subtitles", [&] {
+    GameSubtitleDB db;
+    db.m_subtitle_version = GameSubtitleDB::SubtitleFormat::V2;
+    std::vector<GameSubtitleDefinitionFile> files;
+    open_subtitle_project("subtitle-v2", "game/assets/jak2/game_subtitle.gp", files);
+    for (auto& file : files) {
+      file.lines_path = remap(file.lines_path);
+      file.meta_path = remap(file.meta_path);
+      if (file.lines_base_path) {
+        file.lines_base_path = remap(file.lines_base_path.value());
+      }
+      if (file.meta_base_path) {
+        file.meta_base_path = remap(file.meta_base_path.value());
+      }
+    }
+    compile_game_subtitles(files, db, kGame);
+  });
+
+  step("DGO and CGO files", [&] {
+    const auto code = read_code_pack(proj / "CODE.PAK");
+    lg::info("[build] CODE.PAK: {} code objects", code.size());
+    if (build_dgos(code) != 0) {
+      failed++;
+    }
+  });
+  return failed;
+}
+
+}  // namespace jakompiled
