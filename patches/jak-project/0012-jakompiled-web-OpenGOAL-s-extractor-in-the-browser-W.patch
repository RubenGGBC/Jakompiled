diff --git a/web/extract_web.cpp b/web/extract_web.cpp
new file mode 100644
index 00000000..852099fb
--- /dev/null
+++ b/web/extract_web.cpp
@@ -0,0 +1,45 @@
+// Jakompiled web: filesystem of the in-browser extractor (decompiler/extractor/main.cpp built with
+// Emscripten and WasmFS).
+//
+//   /data                    project dir (--proj-path): decompiler config and texture assets,
+//                            embedded in the module (no game data)
+//   /data/iso_data       ->  OPFS /iso_data         files of the user's ISO, written by the page
+//   /data/decompiler_out ->  OPFS /decompiler_out   decompiler output (raw objects, textures...)
+//   /data/out            ->  OPFS /out              fr3 files for the PC renderers
+//   /data/log            ->  OPFS /log              extractor logs
+//
+// Everything derived from the ISO lives in the browser's origin private file system (OPFS) and
+// never leaves the user's machine. The module must run in a Worker: the OPFS backend blocks.
+
+#include <cerrno>
+#include <cstring>
+#include <string>
+
+#include <emscripten/wasmfs.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "common/log/log.h"
+
+namespace jakompiled {
+
+void extract_setup_fs() {
+  backend_t opfs = wasmfs_create_opfs_backend();
+  if (wasmfs_create_directory("/opfs", 0777, opfs) != 0) {
+    lg::die("jakompiled: can't mount OPFS at /opfs");
+  }
+  mkdir("/data", 0777);
+  chmod("/data", 0777);  // the embedded files' directory is read-only by default
+  for (const char* dir : {"iso_data", "decompiler_out", "out", "log"}) {
+    const std::string target = std::string("/opfs/") + dir;
+    const std::string link = std::string("/data/") + dir;
+    if (mkdir(target.c_str(), 0777) != 0 && errno != EEXIST) {
+      lg::die("jakompiled: can't create {}: {}", target, strerror(errno));
+    }
+    if (symlink(target.c_str(), link.c_str()) != 0 && errno != EEXIST) {
+      lg::die("jakompiled: can't link {} -> {}: {}", link, target, strerror(errno));
+    }
+  }
+}
+
+}  // namespace jakompiled
