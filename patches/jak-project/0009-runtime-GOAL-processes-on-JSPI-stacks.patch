index 00000000..f910b33f
--- /dev/null
+++ b/web/goal_kernel_web.cpp
@@ -0,0 +1,300 @@
+// Jakompiled web: runtime primitives behind the wasm versions of the GOAL kernel asm-funcs
+// (goal_src/jak2/kernel/gkernel.gc, gstate.gc, under INSTRUCTION_SET 'wasm).
+//
+// On x86 the kernel switches between processes by saving registers, copying stacks and jumping
+// to saved addresses. Wasm can't do any of that, so:
+//
+//  - Every process main thread runs on its own JSPI stack ("fiber"). The kernel's thread-resume
+//    calls jakompiled-thread-resume, which starts or wakes the fiber and suspends the kernel
+//    (EE thread) until the fiber calls jakompiled-thread-suspend or ends.
+//  - Non-local exits are C++ exceptions (built with -fwasm-exceptions, so they unwind through
+//    GOAL wasm frames and don't put JS frames on the stack, which JSPI can't suspend through):
+//      ThreadExit     return-from-thread, return-from-thread-dead, abandon-thread
+//      ThreadRestart  go, from the main thread: restart the thread on the new state's code
+//      GoalThrow      throw-dispatch: return a value from a catch frame
+//  - Each fiber has its own C stack (Emscripten's __stack_pointer), switched on every resume
+//    and suspend: C++ frames of a suspended fiber must not be overwritten by the kernel.
+//  - The GOAL stack pointer and pp are wasm globals shared by all GOAL modules (env.sp, env.pp);
+//    the GOAL code saves and restores the GOAL stack contents like on x86.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+
+#include <emscripten.h>
+
+#include "common/common_types.h"
+#include "common/goal_constants.h"
+#include "common/log/log.h"
+
+#include "game/kernel/common/goal_c_fn.h"
+#include "game/kernel/jak2/kscheme.h"
+
+extern u8* g_ee_main_mem;
+
+namespace {
+
+constexpr u32 kFiberCStackSize = 256 * 1024;
+
+struct ThreadExit {};
+struct ThreadRestart {
+  u64 code;
+  u64 args[4];
+  u64 stack_top;
+};
+struct GoalThrow {
+  u64 frame;
+  u64 value;
+};
+
+using GoalFunction = u64 (*)(u64, u64, u64, u64, u64, u64, u64, u64);
+
+GoalFunction goal_function(u64 function_object) {
+  u32 table_index;
+  memcpy(&table_index, g_ee_main_mem + (u32)function_object, 4);
+  if (!table_index) {
+    lg::die("jakompiled: call to GOAL function object 0x{:x} without wasm code", function_object);
+  }
+  return (GoalFunction)(uintptr_t)table_index;
+}
+
+// C stacks of the fibers, by thread (GOAL address)
+std::unordered_map<u32, u8*> g_fiber_c_stacks;
+
+}  // namespace
+
+// ---- JS side: GOAL globals and fibers. State lives in globalThis.jak of the EE worker.
+
+EM_JS_DEPS(jakompiled_kernel, "$stackSave,$stackRestore");
+
+EM_JS(void, js_kernel_init, (), {
+  if (globalThis.jak) return;
+  globalThis.jak = {
+    sp : new WebAssembly.Global({value : 'i64', mutable : true}, 0n),
+    pp : new WebAssembly.Global({value : 'i64', mutable : true}, 0n),
+    fibers : new Map(),  // thread -> {wake, sp}
+    kernelWake : null,
+    fiberMain : null,
+  };
+});
+
+EM_JS(uint64_t, js_get_sp, (), { return globalThis.jak.sp.value; });
+EM_JS(void, js_set_sp, (uint64_t v), { globalThis.jak.sp.value = v; });
+
+// Kernel side: start (pc != 0) or wake (pc == 0) the fiber of a thread, and wait until it
+// suspends (returns 0) or ends (returns 1).
+// clang-format off
+EM_ASYNC_JS(int, js_resume, (uint32_t thread, uint32_t pc, uint32_t c_stack_top), {
+  const J = globalThis.jak;
+  const kernelSP = stackSave();
+  const finished = await new Promise((resolve) => {
+    J.kernelWake = resolve;
+    if (pc === 0) {
+      const f = J.fibers.get(thread);
+      if (!f || !f.wake) {
+        err(`[jakompiled] thread-resume: thread 0x${thread.toString(16)} has no suspended stack`);
+        resolve(1);
+        return;
+      }
+      const wake = f.wake;
+      f.wake = null;
+      wake();
+    } else {
+      // a new fiber (also when set-to-run reset a suspended thread: its old stack is dropped)
+      J.fibers.set(thread, {wake : null, sp : 0});
+      J.fiberMain ??= WebAssembly.promising(wasmExports['jakompiled_fiber_main']);
+      stackRestore(c_stack_top);
+      J.fiberMain(thread, pc).catch((e) => {
+        err(`[jakompiled] process thread 0x${thread.toString(16)} crashed: ${e}`);
+        J.fibers.delete(thread);
+        J.kernelWake?.(1);
+      });
+    }
+  });
+  stackRestore(kernelSP);
+  return finished;
+});
+
+// Fiber side: give control back to the kernel until it resumes this thread.
+EM_ASYNC_JS(void, js_suspend, (uint32_t thread), {
+  const J = globalThis.jak;
+  const f = J.fibers.get(thread);
+  f.sp = stackSave();
+  const woken = new Promise((resolve) => { f.wake = resolve; });
+  const wake = J.kernelWake;
+  J.kernelWake = null;
+  wake(0);
+  await woken;
+  stackRestore(f.sp);
+});
+// clang-format on
+
+// Fiber side: the fiber's code ended, the kernel can continue.
+EM_JS(void, js_fiber_done, (uint32_t thread), {
+  const J = globalThis.jak;
+  J.fibers.delete(thread);
+  const wake = J.kernelWake;
+  J.kernelWake = null;
+  if (wake) wake(1);
+});
+
+namespace {
+
+u32 g_current_fiber_thread = 0;
+
+u64 get_sp() {
+  return js_get_sp();
+}
+
+void set_sp(u64 v) {
+  js_set_sp(v);
+}
+
+// ---- primitives called from GOAL (registered by register_kernel_primitives)
+
+u64 jakompiled_get_sp() {
+  return get_sp();
+}
+
+void jakompiled_thread_exit() {
+  throw ThreadExit{};
+}
+
+void jakompiled_thread_restart(u64 code, u64 a0, u64 a1, u64 a2, u64 a3, u64 stack_top) {
+  throw ThreadRestart{code, {a0, a1, a2, a3}, stack_top};
+}
+
+void jakompiled_throw(u64 frame, u64 value) {
+  throw GoalThrow{frame, value};
+}
+
+u64 jakompiled_call_on_stack(u64 func, u64 stack_top) {
+  const u64 saved_sp = get_sp();
+  set_sp(stack_top);
+  u64 result = 0;
+  try {
+    result = goal_function(func)(0, 0, 0, 0, 0, 0, 0, 0);
+  } catch (ThreadExit&) {
+    result = 0;
+  }
+  set_sp(saved_sp);
+  return result;
+}
+
+u64 jakompiled_catch(u64 frame, u64 func, u64 param_block) {
+  u64 p[6];
+  memcpy(p, g_ee_main_mem + (u32)param_block, sizeof(p));
+  const u64 saved_sp = get_sp();
+  try {
+    return goal_function(func)(p[0], p[1], p[2], p[3], p[4], p[5], 0, 0);
+  } catch (GoalThrow& t) {
+    if (t.frame != frame) {
+      throw;
+    }
+    set_sp(saved_sp);
+    return t.value;
+  }
+}
+
+void jakompiled_thread_resume(u64 thread, u64 pc, u64 sp) {
+  const u64 kernel_sp = get_sp();
+  const u32 t = (u32)thread;
+  set_sp(sp);
+  u32 c_stack_top = 0;
+  if (pc != 0) {
+    // new fiber: fresh C stack (the old one, if set-to-run reset a suspended thread, is dropped)
+    auto& stack = g_fiber_c_stacks[t];
+    if (!stack) {
+      stack = (u8*)aligned_alloc(16, kFiberCStackSize);
+    }
+    c_stack_top = (u32)(uintptr_t)(stack + kFiberCStackSize);
+  }
+  const u32 prev = g_current_fiber_thread;
+  g_current_fiber_thread = t;
+  const int finished = js_resume(t, (u32)pc, c_stack_top);
+  g_current_fiber_thread = prev;
+  if (finished) {
+    auto it = g_fiber_c_stacks.find(t);
+    if (it != g_fiber_c_stacks.end()) {
+      free(it->second);
+      g_fiber_c_stacks.erase(it);
+    }
+  }
+  set_sp(kernel_sp);
+}
+
+void jakompiled_thread_suspend() {
+  if (!g_current_fiber_thread) {
+    lg::die("jakompiled: suspend outside of a process main thread");
+  }
+  const u32 me = g_current_fiber_thread;
+  js_suspend(me);
+  g_current_fiber_thread = me;
+}
+
+}  // namespace
+
+// Entry of a fiber: run the thread's code (set-to-run-bootstrap), restarting it on go.
+extern "C" EMSCRIPTEN_KEEPALIVE uint64_t jakompiled_fiber_main(uint32_t thread, uint32_t pc) {
+  g_current_fiber_thread = thread;
+  u64 code = pc;
+  u64 args[4] = {0, 0, 0, 0};
+  // on x86 the code of a state is entered with return-from-thread-dead as its return address
+  const u64 return_from_thread_dead = jak2::intern_from_c("return-from-thread-dead")->value();
+  bool exiting = false;
+  for (;;) {
+    try {
+      goal_function(code)(args[0], args[1], args[2], args[3], 0, 0, 0, 0);
+      if (exiting) {
+        break;
+      }
+      // the code returned: continue in return-from-thread-dead (deactivate, back to the kernel)
+      code = return_from_thread_dead;
+      memset(args, 0, sizeof(args));
+      exiting = true;
+    } catch (ThreadRestart& r) {
+      exiting = false;
+      code = r.code;
+      memcpy(args, r.args, sizeof(args));
+      set_sp(r.stack_top);
+    } catch (ThreadExit&) {
+      break;
+    } catch (GoalThrow& t) {
+      lg::error("jakompiled: throw to catch frame 0x{:x} escaped process thread 0x{:x}", t.frame,
+                thread);
+      break;
+    }
+  }
+  js_fiber_done(thread);
+  return 0;
+}
+
+namespace jakompiled {
+
+u64 goal_stack_pointer() {
+  return get_sp();
+}
+
+void set_goal_stack_pointer(u64 v) {
+  set_sp(v);
+}
+
+void kernel_init() {
+  js_kernel_init();
+}
+
+void register_kernel_primitives() {
+  using jak2::make_function_symbol_from_c;
+  make_function_symbol_from_c("jakompiled-get-sp", GOAL_C_FN(jakompiled_get_sp));
+  make_function_symbol_from_c("jakompiled-thread-exit", GOAL_C_FN(jakompiled_thread_exit));
+  make_function_symbol_from_c("jakompiled-thread-restart", GOAL_C_FN(jakompiled_thread_restart));
+  make_function_symbol_from_c("jakompiled-thread-resume", GOAL_C_FN(jakompiled_thread_resume));
+  make_function_symbol_from_c("jakompiled-thread-suspend", GOAL_C_FN(jakompiled_thread_suspend));
+  make_function_symbol_from_c("jakompiled-call-on-stack", GOAL_C_FN(jakompiled_call_on_stack));
+  make_function_symbol_from_c("jakompiled-catch", GOAL_C_FN(jakompiled_catch));
+  make_function_symbol_from_c("jakompiled-throw", GOAL_C_FN(jakompiled_throw));
+}
+
+}  // namespace jakompiled
