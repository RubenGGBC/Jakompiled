;;-*-Lisp-*-
;; Fase 1: benchmark nativo (x86-64) con el codegen real de goalc.
;; Se carga sobre el kernel de Jak 2 (no necesita ISO).
;; Las funciones son copias literales de goal_src/jak2 (renombradas con bench-).

;; ---- tipos y macros mínimos (en el juego viven en engine/math, fuera del kernel)

(deftype bmatrix (structure)
  ((data float 16)
   (quad uint128 4 :offset 0))
  )

(defmacro bench-unwrap-angle (angle)
  `(the float (sar (shl (the int ,angle) 48) 48))
  )

;; ---- 1. engine/math/matrix.gc: matrix*!  (vf -> SIMD)

(defun bench-matrix*! ((arg0 bmatrix) (arg1 bmatrix) (arg2 bmatrix))
  (rlet ((acc :class vf)
         (vf10 :class vf)
         (vf11 :class vf)
         (vf12 :class vf)
         (vf13 :class vf)
         (vf14 :class vf)
         (vf15 :class vf)
         (vf16 :class vf)
         (vf17 :class vf)
         (vf18 :class vf)
         (vf19 :class vf)
         (vf20 :class vf)
         (vf21 :class vf)
         )
    (.lvf vf10 (&-> arg1 quad 0))
    (.lvf vf14 (&-> arg2 quad 0))
    (.lvf vf15 (&-> arg2 quad 1))
    (.lvf vf16 (&-> arg2 quad 2))
    (.lvf vf17 (&-> arg2 quad 3))
    (.lvf vf11 (&-> arg1 quad 1))
    (.lvf vf12 (&-> arg1 quad 2))
    (.lvf vf13 (&-> arg1 quad 3))
    (.mul.x.vf acc vf14 vf10)
    (.add.mul.y.vf acc vf15 vf10 acc)
    (.add.mul.z.vf acc vf16 vf10 acc)
    (.add.mul.w.vf vf18 vf17 vf10 acc)
    (.mul.x.vf acc vf14 vf11)
    (.add.mul.y.vf acc vf15 vf11 acc)
    (.add.mul.z.vf acc vf16 vf11 acc)
    (.add.mul.w.vf vf19 vf17 vf11 acc)
    (.mul.x.vf acc vf14 vf12)
    (.add.mul.y.vf acc vf15 vf12 acc)
    (.add.mul.z.vf acc vf16 vf12 acc)
    (.add.mul.w.vf vf20 vf17 vf12 acc)
    (.mul.x.vf acc vf14 vf13)
    (.add.mul.y.vf acc vf15 vf13 acc)
    (.add.mul.z.vf acc vf16 vf13 acc)
    (.add.mul.w.vf vf21 vf17 vf13 acc)
    (.svf (&-> arg0 quad 0) vf18)
    (.svf (&-> arg0 quad 1) vf19)
    (.svf (&-> arg0 quad 2) vf20)
    (.svf (&-> arg0 quad 3) vf21)
    arg0
    )
  )

;; ---- 2. engine/math/trigonometry.gc: sin  (float escalar)

(defun bench-sin ((arg0 float))
  (let ((f2-0 (* 0.000095873795 (bench-unwrap-angle arg0))))
    f2-0
    (let* ((f1-4 (* 0.999998 f2-0))
           (f0-3 (* f2-0 f2-0))
           (f2-1 (* f2-0 f0-3))
           (f1-5 (+ f1-4 (* -0.16666014 f2-1)))
           (f2-2 (* f2-1 f0-3))
           (f1-6 (+ f1-5 (* 0.008326521 f2-2)))
           (f2-3 (* f2-2 f0-3))
           (f1-7 (+ f1-6 (* -0.0001956241 f2-3)))
           (f0-4 (* f2-3 f0-3))
           )
      (+ f1-7 (* 0.0000023042373 f0-4))
      )
    )
  )

;; ---- 3. kernel/gstring.gc: string=  (enteros, bucle, bytes)

(defun bench-string= ((arg0 string) (arg1 string))
  (let ((a2-0 (-> arg0 data))
        (v1-0 (-> arg1 data))
        )
    (if (or (zero? arg0) (zero? arg1))
        (return #f)
        )
    (while (and (nonzero? (-> a2-0 0)) (nonzero? (-> v1-0 0)))
      (if (!= (-> a2-0 0) (-> v1-0 0))
          (return #f)
          )
      (set! a2-0 (&-> a2-0 1))
      (set! v1-0 (&-> v1-0 1))
      )
    (and (zero? (-> a2-0 0)) (zero? (-> v1-0 0)))
    )
  )

;; ---- 0. función vacía: mide el coste de llamada

(defun bench-nop ((arg0 int))
  arg0
  )

;; ---- bucles de medida. Cada llamada pasa por el símbolo global, como en el juego.

(defun bench-nop-loop ((n int))
  (let ((acc 0))
    (dotimes (i n)
      (+! acc (bench-nop i))
      )
    acc
    )
  )

(defun bench-matrix-loop ((n int))
  (let ((a (new 'stack-no-clear 'bmatrix))
        (b (new 'stack-no-clear 'bmatrix))
        (c (new 'stack-no-clear 'bmatrix))
        )
    (dotimes (i 16)
      (set! (-> a data i) (if (zero? (mod i 5)) 1.0 0.0))
      (set! (-> b data i) (* 0.25 (the float (+ i 1))))
      )
    (dotimes (i n)
      (bench-matrix*! c a b)
      )
    (the int (* 1000.0 (+ (-> c data 0) (-> c data 15))))
    )
  )

(defun bench-sin-loop ((n int))
  (let ((acc 0.0))
    (dotimes (i n)
      (+! acc (bench-sin (the float i)))
      )
    (the int acc)
    )
  )

(defun bench-string-loop ((n int))
  (let ((cnt 0))
    (dotimes (i n)
      (if (bench-string= "the quick brown fox jumps over!!" "the quick brown fox jumps over!!")
          (+! cnt 1)
          )
      )
    cnt
    )
  )
